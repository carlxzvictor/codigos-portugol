programa
{
	
	funcao inicio()
	{
		inteiro regiao 
		escreva(" 1: Norte, 2: Nordeste, 3: Sudeste, 4: Sul, 5: Centro-Oeste\n")
		escreva("Digite o numero da região em que você vive: ")
		leia(regiao)
		escolha(regiao){
			caso 1:
			escreva("Você Escolheu a região NORTE: ")
			pare
			caso 2: 
			escreva("Você Escolheu a região NORDESTE: ")
			pare
			caso 3: 
			escreva("Você Escolheu a região SUDESTE: ")
			pare
			caso 4:
			escreva("Você Escolheu a região SUL: ")
			pare
			caso 5:
			escreva("Você escolheu a região Centro-Oeste: ")
			pare
			caso contrario:
			escreva(" Região Invalída. ")
			pare
			
		}
	}
}
