programa
{
	
	funcao inicio()
	{
		cadeia usuario
		cadeia senha

		escreva("Digite o seu usuário: ")
		leia(usuario)
		escreva("\n")
		escreva("Digite a sua senha: ")
		leia(senha)

		se(usuario== "LukasManDab1" e senha== "paradonobaiao13"){
			escreva("Acesso autorizado a sua conta.")
		}
		senao{
			escreva("Acesso Negado.")
		}
	}
}
